    "This way up it needs no fins, 0 g." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Ausrichtung werden keine Finnen benötigt, 0 g."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个朝向上不需要鳍片，0 g。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesta posição não precisa de aletas, 0 g."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بهذه الوضعية لا تحتاج القطعة إلى زعانف دعم (0 g)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deze oriëntatie zijn geen vinnen nodig, 0 g."
          }
        }
      }
    },
    "This way up the bores point up, so there's no support to pull out of a hole (%@ g of fins, all on the outside)." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个朝向使孔朝上，无需从孔内拆除支撑（鳍片共 %1$@ g，全部位于外侧）。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesta posição os furos ficam para cima, então não há suporte para puxar de dentro de um furo (%1$@ g de aletas, todas por fora)."
          }
        }
      }
    },
    "Times and filament from %@; yours will differ." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiten und Filament aus %1$@; bei Ihnen weicht es ab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间与耗材按 %1$@ 估算，你的实际数值会不同。"

    "%lld overhang is bowl-shaped rather than a ledge — its lowest points form a ring, not a line, so there is nothing for a wall to follow. Rotate, or switch to Draw and place one by hand" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "有 %1$lld 处悬垂呈碗状而非台阶状 —— 它们的最低点围成一圈，而不是一条线，墙没有可跟随的路径。请旋转零件，或切换到「绘制」手动放置"
                }
              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld balanço tem forma de tigela em vez de aba — os pontos mais baixos formam um anel, não uma linha, então não há o que uma parede seguir. Gire, ou mude para Desenhar e posicione uma à mão"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld balanços têm forma de tigela em vez de aba — os pontos mais baixos formam um anel, não uma linha, então não há o que uma parede seguir. Gire, ou mude para Desenhar e posicione uma à mão"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhang is bowl-shaped rather than a ledge — its lowest points form a ring, not a line, so there is nothing for a wall to follow. Rotate, or switch to Draw and place one by hand"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhangs are bowl-shaped rather than a ledge — their lowest points form a ring, not a line, so there is nothing for a wall to follow. Rotate, or switch to Draw and place one by hand"
                }
              }
            }
          }
        }
      }
    },
    "%lld overhang is too shallow for a fin this way up. Tilt the part steeper so a fin can follow it (try Suggest orientation), or add a wall by hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Überhang ist zu flach für eine Finne in dieser Lage. Neigen Sie das Bauteil steiler, damit eine Finne folgen kann (versuchen Sie „Ausrichtung vorschlagen“), oder fügen Sie manuell eine Stützwand hinzu."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Überhänge sind zu flach für eine Finne in dieser Lage. Neigen Sie das Bauteil steiler, damit eine Finne folgen kann (versuchen Sie „Ausrichtung vorschlagen“), oder fügen Sie manuell eine Stützwand hinzu."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "在这个朝向上有 %1$lld 处悬垂过于平缓，放不下鳍片。请把零件倾斜得更陡，让鳍片能够贴合（试试「推荐摆位」），或手动添加一堵墙。"
                }
              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld balanço é raso demais para uma aleta nesta posição. Incline mais a peça para uma aleta conseguir acompanhá-lo (tente Sugerir orientação), ou adicione uma parede à mão."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld balanços são rasos demais para uma aleta nesta posição. Incline mais a peça para uma aleta conseguir acompanhá-los (tente Sugerir orientação), ou adicione uma parede à mão."
                }
              }
            }
          }
        },
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld بروز معلق زاويته منخفضة جداً بالنسبة لزعنفة بهذه الوضعية. أمِل القطعة أكثر حتى تتمكن الزعنفة من اتباعه (جرّب «اقتراح وضعية»)، أو أضف جداراً يدوياً."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld بروزات معلّقة زواياها منخفضة جداً بالنسبة لزعنفة بهذه الوضعية. أمِل القطعة أكثر حتى تتمكن الزعنفة من اتباعها (جرّب «اقتراح وضعية»)، أو أضف جداراً يدوياً."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhang is in deze oriëntatie te flauw voor een steunvin. Kantel het onderdeel verder, zodat een steunvin de overhang kan volgen (probeer ‘Oriëntatie voorstellen’), of voeg handmatig een wand toe."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhangen zijn in deze oriëntatie te flauw voor een steunvin. Kantel het onderdeel verder, zodat een steunvin de overhangen kan volgen (probeer ‘Oriëntatie voorstellen’), of voeg handmatig een wand toe."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhang is too shallow for a fin this way up. Tilt the part steeper so a fin can follow it (try Suggest orientation), or add a wall by hand."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld overhangs are too shallow for a fin this way up. Tilt the part steeper so a fin can follow it (try Suggest orientation), or add a wall by hand."

            "value" : "Este arquivo tem vários objetos"
          }
        }
      }
    },
    "This file unpacks to %@ (the limit is %@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei wird auf %1$@ entpackt (die Grenze liegt bei %2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件解压后为 %1$@（上限为 %2$@）。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo se descompacta para %1$@ (o limite é %2$@)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند فك ضغط هذا الملف يصبح حجمه %1$@ (الحد الأقصى %2$@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand pakt uit tot %1$@ (de limiet is %2$@)."
          }
        }
      }
    },
    "This is about the strongest printable orientation for this load — a better-aligned pose wouldn’t sit on the bed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist für diese Last etwa die stabilste druckbare Lage — eine besser ausgerichtete Lage stünde nicht auf dem Druckbett."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这大约是该受力下最结实的可用打印姿态 —— 朝向更好的姿态无法稳定放在热床上。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é praticamente a orientação imprimível mais forte para essa carga — uma posição mais alinhada não se apoiaria na mesa."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه تقريباً أقوى وضعية قابلة للطباعة لهذا الحمل — فالوضعية الأفضل محاذاةً لن تستقر على سطح الطباعة."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is ongeveer de sterkste printbare oriëntatie voor deze belasting — een beter uitgelijnde positie zou niet op het printbed staan."
          }
        }
      }
    },
    "This model is %@ across (the limit is %@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell ist %1$@ breit (die Grenze liegt bei %2$@)."
          }

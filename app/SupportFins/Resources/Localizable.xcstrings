    "Tines fuse the support to the part so it grips instead of just propping. Off = plain breakaway wall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltezacken verbinden die Stütze mit dem Bauteil, damit sie greift, statt nur zu stützen. Aus = einfache Stützwand."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "齿把支撑熔接到零件上，使其咬住而不只是顶住。关闭 = 普通易拆墙。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dentes fundem o suporte à peça para ele prender em vez de só escorar. Desligado = parede destacável simples."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجعل أسنان التثبيت الدعامة تتشابك مع القطعة كي تثبّتها بدلاً من الاكتفاء بإسنادها. إيقاف = جدار دعم عادي قابل للكسر."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tanden verbinden de support met het onderdeel, zodat die grip biedt in plaats van alleen te ondersteunen. Uit = gewone losbreekbare wand."
          }
        }
      }
    },

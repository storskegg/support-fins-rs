          }
        }
      }
    },
    "This prints clean lying flat. You only need fins if you're tilting it for strength." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druckt flach aufliegend sauber. Stützen werden nur benötigt, wenn das Teil für mehr Stabilität geneigt wird."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平放即可干净打印。只有在为了强度而倾斜摆放时才需要鳍片。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deitada ela imprime limpa. Só precisa de aletas se você for incliná-la para ganhar resistência."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبع هذه القطعة بشكل نظيف وهي مسطحة. لا تحتاج إلى زعانف إلا إذا كنت ستميلها لزيادة القوة."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit print netjes als het plat ligt. Steunvinnen zijn alleen nodig als je het kantelt voor extra stevigheid."
          }
        }
      }
    },
    "This prints clean lying flat. You only need fins if you’re placing them by hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druckt flach aufliegend sauber. Stützen werden nur benötigt, wenn Sie sie manuell platzieren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平放即可干净打印。只有当你想手动放置支撑时才需要鳍片。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deitada ela imprime limpa. Só precisa de aletas se você for colocá-las à mão."
          }
        },
        "ar" : {
          "stringUnit" : {

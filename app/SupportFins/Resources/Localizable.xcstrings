    "%lld flat face found, but every one starts too far up the part — a fin would be mostly bare stilt. Rotate so a flat face runs down to the plate" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "找到了 %1$lld 个平整面，但它们的起始位置都离热床过高 —— 鳍片的大部分高度将独立竖立，无法与零件连接。请旋转零件，让一个平整面向下延伸至热床"
                }
              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld face plana encontrada, mas ela começa alto demais na peça — a aleta seria quase toda uma perna solta. Gire para uma face plana descer até a mesa"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld faces planas encontradas, mas todas começam alto demais na peça — a aleta seria quase toda uma perna solta. Gire para uma face plana descer até a mesa"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld flat face found, but every one starts too far up the part — a fin would be mostly bare stilt. Rotate so a flat face runs down to the plate"
                }
              },
              "other" : {
                "stringUnit" : {

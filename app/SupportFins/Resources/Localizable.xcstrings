    },
    "Fins come baked in — no slicer supports needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stützen sind integriert – keine Slicer-Stützen nötig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鳍片已内置 —— 无需切片软件支撑。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aletas já vêm embutidas — sem suportes do fatiador."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزعانف مدمجة في الملف — لا حاجة إلى دعامات برنامج التقطيع."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vinnen zijn ingebouwd — slicer-supports zijn niet nodig."
          }
        }
      }
    },
    "Fins on" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finnen aktiv"
          }
        },
        "zh-Hans" : {

    "Home view: front right, from above. Keeps the zoom." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startansicht: von vorne rechts, von oben. Behält den Zoom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始视图：右前方俯视。保持缩放。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

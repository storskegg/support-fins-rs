              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld steun is ingekort of weggelaten omdat een deel van het model onder de overhang zit en ‘Alleen op het printbed’ is ingeschakeld. Schakel deze optie uit om de steun op het onderdeel te plaatsen."
                }
              },
              "other" : {
                "stringUnit" : {

    "Auto already reaches every overhang here, so Full coverage added nothing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto erreicht hier bereits jeden Überhang, daher hat die vollständige Abdeckung nichts hinzugefügt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自动」在此已覆盖到每一个悬垂，因此全覆盖没有额外添加内容。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Automático já alcança todo balanço aqui, então a Cobertura total não adicionou nada."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل الوضع «تلقائي» بالفعل إلى كل بروز معلق هنا، لذا لم تضف التغطية الكاملة شيئاً."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch bereikt hier al elke overhang, dus Volledige dekking heeft niets toegevoegd."
          }
        }
      }
    },
    "Auto leaves %@ mm² (%@ %%) of overhang more than %@ mm from a wall — Full coverage adds walls there" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto lässt %1$@ mm² (%2$@ %%) Überhang mehr als %3$@ mm von einer Wand entfernt — Volle Abdeckung setzt dort Wände"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自动」留下 %1$@ mm²（%2$@ %%）的悬垂距墙超过 %3$@ mm —— 「全覆盖」会在那里加墙"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Automático deixa %1$@ mm² (%2$@ %%) de balanço a mais de %3$@ mm de uma parede — a Cobertura total põe paredes ali"
          }
        },
        "ar" : {
          "stringUnit" : {

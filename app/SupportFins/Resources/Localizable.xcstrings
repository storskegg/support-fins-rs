    "%lld spot starts in midair (%@): its first layer has nothing under it, though no face there is steep enough to show red. Full coverage puts a wall under it if it can reach it; in Auto or Draw, add a wall by hand under it or tilt the part." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg ponto começa no ar (%2$@): a primeira camada dele não tem nada embaixo, embora nenhuma face ali seja inclinada o bastante para aparecer em vermelho. A Cobertura total põe uma parede embaixo dele se conseguir alcançá-lo; no Automático ou no Desenhar, adicione uma parede à mão embaixo dele ou incline a peça."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pontos começam no ar (%2$@): a primeira camada deles não tem nada embaixo, embora nenhuma face ali seja inclinada o bastante para aparecer em vermelho. A Cobertura total põe uma parede sob cada um que conseguir alcançar; no Automático ou no Desenhar, adicione uma parede à mão sob cada um ou incline a peça."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg spot starts in midair (%2$@): its first layer has nothing under it, though no face there is steep enough to show red. Full coverage puts a wall under it if it can reach it; in Auto or Draw, add a wall by hand under it or tilt the part."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg spots start in midair (%2$@): their first layer has nothing under it, though no face there is steep enough to show red. Full coverage puts a wall under each one it can reach; in Auto or Draw, add a wall by hand under each or tilt the part."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde ficam os suportes"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أين توضع الدعامات"

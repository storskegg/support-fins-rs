      }
    },
    "Where the pad meets the part's underside. Positive bites in to hold harder; 0 is flush; negative leaves a gap that snaps off cleaner." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo der Fuß auf die Unterseite des Bauteils trifft. Positiv greift tiefer für besseren Halt; 0 ist bündig; negativ lässt einen Spalt für saubereres Abbrechen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底板垫与零件底面相接的位置。正值＝咬入零件，固定更牢；0＝齐平；负值＝留出间隙，折断时更干净。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde a base encosta na parte de baixo da peça. Positivo morde a peça para segurar mais; 0 é rente; negativo deixa uma folga que destaca mais limpo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضع التقاء قاعدة التثبيت بالسطح السفلي للقطعة. تجعل القيمة الموجبة القاعدة تتداخل مع القطعة لتثبيتها بقوة أكبر؛ وتعني القيمة 0 أن السطحين على مستوى واحد؛ أما القيمة السالبة فتترك فجوة تسهّل فصل القاعدة بنظافة."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar het hechtvlak de onderkant van het onderdeel raakt. Een positieve waarde dringt verder in het onderdeel voor een stevigere hechting; 0 is vlak; een negatieve waarde laat een spleet achter, zodat het hechtvlak netter afbreekt."
          }
        }
      }
    },
    "Who places the support." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, wer die Stützen platziert."
          }
        },
        "zh-Hans" : {

    "Setup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundeinstellungen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Überhang ist zu flach für eine Finne in dieser Lage. Neigen Sie das Bauteil steiler, damit eine Finne folgen kann (versuchen Sie „Ausrichtung vorschlagen“), oder fügen Sie manuell eine Stützwand hinzu."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Überhänge sind zu flach für eine Finne in dieser Lage. Neigen Sie das Bauteil steiler, damit eine Finne folgen kann (versuchen Sie „Ausrichtung vorschlagen“), oder fügen Sie manuell eine Stützwand hinzu."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {

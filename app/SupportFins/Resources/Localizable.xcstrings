                  "value" : "%1$lld faces planas encontradas, mas todas começam alto demais na peça — a aleta seria quase toda uma perna solta. Gire para uma face plana descer até a mesa"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld flat face found, but every one starts too far up the part — a fin would be mostly bare stilt. Rotate so a flat face runs down to the plate"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld flat faces found, but every one starts too far up the part — a fin would be mostly bare stilt. Rotate so a flat face runs down to the plate"
                }
              }
            }
          }
        }
      }
    },

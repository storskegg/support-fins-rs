    "Vertical distance between brace tines. Smaller = held tighter, more marks on the side. Default 6mm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikaler Abstand zwischen den Rippenzacken. Kleiner = festerer Halt, aber mehr Kontaktpunkte. Standard 6 mm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防晃撑齿之间的垂直间距。越小＝固定越紧，侧面留下的痕迹越多。默认 6 mm。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância vertical entre os dentes da escora. Menor = mais presa, mais marcas na lateral. Padrão 6 mm."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة الرأسية بين أسنان التثبيت. كلما صغرت المسافة زادت قوة التثبيت وازدادت العلامات على جانب القطعة. القيمة الافتراضية 6 mm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verticale afstand tussen de tanden van de schoor. Kleiner = steviger vastgehouden, maar meer afdrukken aan de zijkant. Standaard: 6 mm."
          }
        }
      }
    },

    "Curved walls stopped at the wall limit with %@ mm² of overhang still bare — untick it, or switch to Full coverage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebogene Wände hat das Wandlimit erreicht, %1$@ mm² Überhang sind noch frei — deaktivieren oder zu Volle Abdeckung wechseln"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲面墙在墙数上限处停止，仍有 %1$@ mm² 悬垂裸露 —— 请取消勾选它，或切换到「全覆盖」"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paredes curvas parou no limite de paredes com %1$@ mm² de balanço ainda sem apoio — desmarque, ou mude para Cobertura total"
          }
        }
      }
    },
    "Curved walls: Full coverage does better here with straight walls, so it kept them. Switch to Auto for the curves." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebogene Wände: Volle Abdeckung schneidet hier mit geraden Wänden besser ab und hat sie behalten. Für die Kurven zu Auto wechseln."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲面墙：此处「全覆盖」用直墙效果更好，因此保留了直墙。想要曲面墙请切换到「自动」。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paredes curvas: a Cobertura total se sai melhor aqui com paredes retas, então ficou com elas. Mude para o Automático para ter as curvas."
          }
        }
      }
    },

    "Deno or Node 20.10+ · fins a whole folder · stands in for a plugin in slicers with none: Bambu Studio, QIDI Studio, Creality Print, Snapmaker Orca, Flashforge" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deno oder Node 20.10+ · verarbeitet ganze Ordner · ersetzt das Plugin in Slicern ohne Plugin-System: Bambu Studio, QIDI Studio, Creality Print, Snapmaker Orca, Flashforge"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "%lld support was cut short or left off because part of the model sits under the overhang and Plate only is on. Untick it to stand them on the part." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Stütze wurde gekürzt oder weggelassen, weil Bauteil unter dem Überhang liegt und „Nur Druckplatte“ aktiv ist. Deaktivieren Sie es, um sie auf das Bauteil zu stellen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Stützen wurden gekürzt oder weggelassen, weil Bauteil unter dem Überhang liegt und „Nur Druckplatte“ aktiv ist. Deaktivieren Sie es, um sie auf das Bauteil zu stellen."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "有 %1$lld 处支撑被截短或省略，因为悬垂下方就是模型本体，且开启了「仅热床」。取消勾选即可把它们立在零件上。"
                }
              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld suporte foi encurtado ou omitido porque parte do modelo fica sob o balanço e Só na mesa está ligado. Desmarque para apoiá-lo sobre a peça."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld suportes foram encurtados ou omitidos porque parte do modelo fica sob o balanço e Só na mesa está ligado. Desmarque para apoiá-los sobre a peça."
                }
              }
            }
          }
        },
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld دعامة قُصّرت أو تُركت لأن جزءاً من النموذج يقع تحت البروز المعلّق وخيار «على سطح الطباعة فقط» مفعّل. ألغِ تفعيله لإقامتها على القطعة."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld دعامات قُصّرت أو تُركت لأن جزءاً من النموذج يقع تحت البروز المعلّق وخيار «على سطح الطباعة فقط» مفعّل. ألغِ تفعيله لإقامتها على القطعة."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld steun is ingekort of weggelaten omdat een deel van het model onder de overhang zit en ‘Alleen op het printbed’ is ingeschakeld. Schakel deze optie uit om de steun op het onderdeel te plaatsen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld steunen zijn ingekort of weggelaten omdat een deel van het model onder de overhang zit en ‘Alleen op het printbed’ is ingeschakeld. Schakel deze optie uit om de steunen op het onderdeel te plaatsen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld support was cut short or left off because part of the model sits under the overhang and Plate only is on. Untick it to stand them on the part."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld supports were cut short or left off because part of the model sits under the overhang and Plate only is on. Untick it to stand them on the part."
                }
              }
            }
          }
        }
      }
    },

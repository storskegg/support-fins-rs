    "Height the brace tines start at. 0 = grip the whole height; raise it to tie on only above where the part starts to move." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe, ab der die Rippenzacken greifen. 0 = über die gesamte Höhe; erhöhen, um erst ab dem wackeligen Bereich anzusetzen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防晃撑齿开始咬合的高度。0 = 整个高度都咬住；调高则只在零件开始晃动的部位以上才连接。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura em que os dentes da escora começam. 0 = prende a altura toda; aumente para prender só acima de onde a peça começa a balançar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الارتفاع الذي تبدأ عنده أسنان التثبيت. القيمة 0 تعني تثبيت القطعة على امتداد ارتفاعها كله؛ ارفع القيمة لتبدأ الأسنان فوق النقطة التي تبدأ عندها القطعة بالتمايل."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoogte waarop de tanden van de schoor beginnen. 0 = over de volledige hoogte vastgrijpen; verhoog dit om alleen vast te grijpen boven het punt waar het onderdeel begint te bewegen."
          }
        }
      }
    },

    "Where supports go" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo Stützen stehen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

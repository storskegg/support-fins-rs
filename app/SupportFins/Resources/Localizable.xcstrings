    "%lld of %@ spots that start in midair got no wall: Full coverage couldn’t fit one under it (%@). Add a wall by hand under it, or tilt the part." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg de %2$@ pontos que começam no ar ficou sem parede: a Cobertura total não conseguiu encaixar uma embaixo dele (%3$@). Adicione uma parede à mão embaixo dele, ou incline a peça."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg de %2$@ pontos que começam no ar ficaram sem parede: a Cobertura total não conseguiu encaixar uma sob eles (%3$@). Adicione uma parede à mão sob cada um, ou incline a peça."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg of %2$@ spots that start in midair got no wall: Full coverage couldn’t fit one under it (%3$@). Add a wall by hand under it, or tilt the part."

    "⚠ %lld overhang shaded amber is too small for a fin (under %@ mm² each), so it prints unsupported this way up and may come out rough. Try Suggest orientation to point it up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "⚠ %arg Überhang in Bernstein ist zu klein für eine Finne (unter %2$@ mm²), wird daher in dieser Lage stützenlos gedruckt und kann rau werden. Versuchen Sie „Ausrichtung vorschlagen“, um ihn nach oben zu drehen."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "⚠ %arg Überhänge in Bernstein sind zu klein für eine Finne (unter %2$@ mm²), werden daher in dieser Lage stützenlos gedruckt und können rau werden. Versuchen Sie „Ausrichtung vorschlagen“, um sie nach oben zu drehen."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "⚠ 有 %arg 处标为琥珀色的悬垂太小，放不下鳍片（每处都小于 %2$@ mm²），按当前朝向将无支撑打印，表面可能较粗糙。可试试「推荐姿态」，把它们转到朝上。"
                    }
                  }
                }
              }
            }
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "⚠ %arg balanço em âmbar é pequeno demais para uma aleta (menos de %2$@ mm² cada), então imprime sem suporte nesta posição e pode sair áspero. Tente Sugerir orientação para virá-lo para cima."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",

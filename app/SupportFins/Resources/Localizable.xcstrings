    "This file expands to %@ triangles, which may need about %@ of memory." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei wird zu %1$@ Dreiecken, was etwa %2$@ Arbeitsspeicher benötigen kann."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件会展开为 %1$@ 个三角形，可能需要约 %2$@ 内存。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo se expande para %1$@ triângulos, o que pode exigir cerca de %2$@ de memória."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوسع هذا الملف إلى %1$@ مثلث، وقد يحتاج إلى حوالي %2$@ من الذاكرة."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand breidt uit tot %1$@ driehoeken, wat ongeveer %2$@ geheugen kan vragen."
          }
        }
      }
    },
    "This file has several objects" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件包含多个对象"

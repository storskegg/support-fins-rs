        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A malha do arquivo não pôde ser compartilhada com a GPU."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت مشاركة شبكة الملف مع وحدة معالجة الرسومات."

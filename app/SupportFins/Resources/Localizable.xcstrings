        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het raster van het bestand kon niet met de GPU worden gedeeld."
          }
        }
      }
    },
    "The fins stand a hair off the part (0.2mm) so they pop off. Turn Tines on if you want them to grip." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鳍片与零件之间留有一丝间隙（0.2 mm），以便轻松弹下。如果想让鳍片咬住零件，请开启「齿」。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aletas ficam um fio afastadas da peça (0,2 mm) para soltarem fácil. Ligue os Dentes se quiser que prendam."
          }
        }
      }
    },
    "The load partly crosses the layers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Last kreuzt die Schichten teilweise."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受力方向与打印层平面斜交。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga cruza parcialmente as camadas."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعبر الحمل الطبقات جزئياً."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belasting loopt deels dwars door de lagen."
          }
        }
      }
    },
    "The load pulls straight across the layers — where prints split first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Last zieht quer zu den Schichten — hier reißen Drucke zuerst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受力方向垂直于打印层平面 —— 打印件最容易在层间开裂。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga puxa atravessando as camadas — é onde as impressões rompem primeiro."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤثر القوة عمودياً على الطبقات — وهو الاتجاه الذي تبدأ فيه الطبعة بالانفصال غالباً."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belasting trekt recht dwars door de lagen — daar scheuren prints het eerst."
          }
        }
      }
    },
    "The load runs along the layers — the strong direction. Good." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Last verläuft entlang der Schichten — die stabile Richtung. Gut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受力方向沿打印层平面 —— 这是强度较高的方向。很好。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga corre ao longo das camadas — a direção forte. Bom."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمتد الحمل على طول الطبقات — وهو الاتجاه الأقوى. جيد."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belasting loopt langs de lagen — de sterke richting. Goed."
          }
        }
      }
    },
    "The merged mesh could not be shared with the GPU." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das zusammengeführte Netz konnte nicht mit der GPU geteilt werden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

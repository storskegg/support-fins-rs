    "Clearance between a support top and the part. Bigger = cleaner surface / easier removal; too big stops holding the overhang. Default 0.2mm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand zwischen Stützenoberkante und Bauteil. Größer = sauberere Oberfläche / leichteres Entfernen; zu groß stützt den Überhang nicht mehr ab. Standard 0,2 mm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支撑顶面与零件之间的间隙。越大＝表面越光洁／越容易拆除；太大会失去对悬垂的承托。默认 0.2 mm。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folga entre o topo do suporte e a peça. Maior = superfície mais limpa / remoção mais fácil; grande demais deixa de sustentar o balanço. Padrão 0,2 mm."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة الفاصلة بين أعلى الدعامة والقطعة. كلما زادت تحسّن سطح القطعة وسهُل نزع الدعامة؛ لكن إذا زادت أكثر من اللازم فلن تعود تسند البروز المعلّق. القيمة الافتراضية 0.2 mm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstand tussen de bovenkant van een ondersteuning en het onderdeel. Groter = een netter oppervlak en makkelijker verwijderen; bij een te grote afstand wordt de overhang niet meer ondersteund. Standaard: 0,2 mm."
          }
        }
      }
    },
    "Clearances" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstände & Toleranzen"
          }
        },
        "zh-Hans" : {

    "Right-drag orbits, middle- or Ctrl + right-drag pans, wheel zooms." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechte Maustaste ziehen dreht die Ansicht, mittlere Maustaste oder Strg + rechte Maustaste ziehen verschiebt, Mausrad zoomt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键拖动旋转视角，中键或 Ctrl + 右键拖动平移，滚轮缩放。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastar com o botão direito gira a vista, botão do meio ou Ctrl + botão direito move, a roda dá zoom."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السحب بالزر الأيمن يدور حول القطعة، والسحب بالزر الأوسط أو Ctrl + السحب بالزر الأيمن يحرّك العرض، وعجلة الفأرة للتكبير والتصغير."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep met de rechtermuisknop om te draaien, sleep met de middelste muisknop of Ctrl + sleep met de rechtermuisknop om te verschuiven en gebruik het muwiel om in of uit te zoomen."
          }
        }
      }
    },
